string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(work "${WORK_ROOT}/xlog-tool-${suffix}")
file(MAKE_DIRECTORY "${work}")

function(run_ok)
    execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${work}"
        RESULT_VARIABLE status ERROR_VARIABLE error)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Command failed (${status}) in ${work}\n${error}")
    endif()
endfunction()

function(run_fail)
    execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${work}"
        RESULT_VARIABLE status ERROR_VARIABLE error)
    if(NOT status STREQUAL "1")
        message(FATAL_ERROR "Expected exit code 1, got ${status} in ${work}\n${error}")
    endif()
endfunction()

execute_process(COMMAND "${TOOL}" keygen "私钥.hex" WORKING_DIRECTORY "${work}"
    RESULT_VARIABLE status OUTPUT_VARIABLE public_key ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
string(LENGTH "${public_key}" public_key_length)
if(NOT status STREQUAL "0" OR NOT public_key_length EQUAL 128 OR NOT public_key MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Key generation failed in ${work}\n${error}")
endif()
run_fail("${TOOL}" keygen "私钥.hex")
run_ok("${FIXTURE}" "${public_key}")

set(codecs zlib)
if(ENCODER_HAS_ZSTD)
    list(APPEND codecs zstd)
endif()
foreach(codec IN LISTS codecs)
    file(GLOB logs "${work}/${codec}_*.xlog")
    list(LENGTH logs count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected one encrypted ${codec} log in ${work}")
    endif()
    run_ok("${TOOL}" decode "私钥.hex" "${logs}" "${codec}-解码.log")
    file(READ "${work}/${codec}-解码.log" decoded)
    foreach(marker IN ITEMS "encrypted begin" "encrypted end" "synchronous record")
        if(NOT decoded MATCHES "${marker}")
            message(FATAL_ERROR "Decoded ${codec} log missing ${marker}")
        endif()
    endforeach()
endforeach()

file(GLOB logs "${work}/zlib_*.xlog")
execute_process(COMMAND "${TOOL}" keygen wrong.hex WORKING_DIRECTORY "${work}"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE error)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Could not generate second key\n${error}")
endif()
run_fail("${TOOL}" decode wrong.hex "${logs}" wrong.log)
if(EXISTS "${work}/wrong.log")
    message(FATAL_ERROR "A failed decode left an output file")
endif()
run_fail("${TOOL}" decode "私钥.hex" "${logs}" "zlib-解码.log")
file(READ "${work}/zlib-解码.log" existing)
if(NOT existing MATCHES "synchronous record")
    message(FATAL_ERROR "The existing output was modified")
endif()
file(WRITE "${work}/broken.xlog" "short record")
run_fail("${TOOL}" decode "私钥.hex" broken.xlog broken.log)
if(EXISTS "${work}/broken.log")
    message(FATAL_ERROR "A truncated log left an output file")
endif()

string(ASCII 8 sync_magic)
string(REPEAT "A" 72 invalid_header_fields)
file(WRITE "${work}/invalid-length.xlog" "${sync_magic}${invalid_header_fields}")
run_fail("${TOOL}" decode "私钥.hex" invalid-length.xlog invalid-length.log)
if(EXISTS "${work}/invalid-length.log")
    message(FATAL_ERROR "A record with an invalid payload length left an output file")
endif()

file(REAL_PATH "${WORK_ROOT}" root)
file(REAL_PATH "${work}" work)
cmake_path(IS_PREFIX root "${work}" NORMALIZE inside_root)
if(NOT inside_root OR root STREQUAL work)
    message(FATAL_ERROR "Unexpected test output directory")
endif()
file(REMOVE_RECURSE "${work}")
