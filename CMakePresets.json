{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-static",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "windows-x64",
      "hidden": true,
      "inherits": "windows-static",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg-x64"
      }
    },
    {
      "name": "windows-x86",
      "hidden": true,
      "inherits": "windows-static",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x86-windows-static",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg-x86"
      }
    },
    {
      "name": "msvc-x64",
      "inherits": "windows-x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "msvc-x86",
      "inherits": "windows-x86",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32"
    },
    {
      "name": "clang-x64",
      "inherits": "windows-x64",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_C_COMPILER_TARGET": "x86_64-pc-windows-msvc",
        "CMAKE_CXX_COMPILER_TARGET": "x86_64-pc-windows-msvc"
      }
    },
    {
      "name": "clang-x86",
      "inherits": "windows-x86",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_C_COMPILER_TARGET": "i686-pc-windows-msvc",
        "CMAKE_CXX_COMPILER_TARGET": "i686-pc-windows-msvc"
      }
    },
    {
      "name": "unix",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-x64",
      "inherits": "unix",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "macos-arm64",
      "inherits": "unix",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx-xlog",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      }
    },
    {
      "name": "android-arm64",
      "inherits": "unix",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg-android-arm64",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_shared"
      }
    },
    {
      "name": "ios-arm64",
      "inherits": "unix",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-ios-xlog",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      }
    },
    {
      "name": "ios-simulator-arm64",
      "inherits": "ios-arm64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-ios-simulator-xlog",
        "CMAKE_OSX_SYSROOT": "iphonesimulator"
      }
    }
  ]
}
